#!/bin/sh
# Git hook (Git Bash / Git for Windows). Logica em pre-commit.ps1 para compatibilidade.
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
if command -v powershell.exe >/dev/null 2>&1; then
  powershell.exe -NoProfile -ExecutionPolicy Bypass -File "$SCRIPT_DIR/pre-commit.ps1"
  exit $?
fi
# Fallback sem PowerShell
git diff --cached --name-only | grep -E '(application-secrets\.properties|\.(pfx|p12|pem|key)$)' && exit 1
git diff --cached -U0 | grep -iE '^\+.*(client-secret|ssl-cert-password)' && exit 1
exit 0
