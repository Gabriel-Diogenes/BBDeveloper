# =============================================================================
# CREDENCIAIS — NAO COMMITAR (use application-secrets.properties local)
# Copie este arquivo para:
#   src/main/resources/application-secrets.properties
# =============================================================================

# --- Homologacao ---
bb.homolog.client-id=
bb.homolog.client-secret=
bb.homolog.developer-key=
bb.homolog.ssl-cert-path=certificados/bb-certificado.pfx
bb.homolog.ssl-cert-password=
bb.homolog.pix-key=

# --- Producao ---
bb.producao.client-id=
bb.producao.client-secret=
bb.producao.developer-key=
bb.producao.ssl-cert-path=certificados/bb-certificado-producao.pfx
bb.producao.ssl-cert-password=
bb.producao.pix-key=

# =============================================================================
# Variaveis de ambiente (sobrescrevem o arquivo acima):
#   BB_HOMOLOG_CLIENT_ID, BB_HOMOLOG_CLIENT_SECRET, BB_HOMOLOG_DEVELOPER_KEY
#   BB_HOMOLOG_SSL_CERT_PATH, BB_HOMOLOG_SSL_CERT_PASSWORD, BB_HOMOLOG_PIX_KEY
#   BB_PRODUCAO_CLIENT_ID, BB_PRODUCAO_CLIENT_SECRET, BB_PRODUCAO_DEVELOPER_KEY
